package scoop.db.row

import scoop.collections.HashSet

/** Writes one record as complete named database values. */
public interface RowWriter<T> {
    public fun writeRow(value: T, row: RowBuilder)
}

/** Reads one record by column name. Call finish before construction to check for unknown columns early. */
public interface RowReader<T> {
    public fun readRow(row: RowInput): T
}

/** Chooses the database representation of a single application value. */
public interface ColumnCodec<T> {
    public fun toValue(value: T): RowValue
    public fun fromValue(cell: RowCell): T
}

@Target([AnnotationTarget.Field, AnnotationTarget.Property])
public annotation class DbColumn(
    val name: String = "",
    val required: Boolean = false,
    val emitNull: Boolean = false,
    val ignore: Boolean = false
)

public enum UnknownColumnPolicy {
    Ignore, Reject
}

public struct RowDecodingOptions(
    val unknownColumns: UnknownColumnPolicy = UnknownColumnPolicy.Ignore
)

public class RowMappingException public constructor(public val path: String, message: String)
: Exception(Some(message))

/** Collects columns in insertion order. Each built row is an independent snapshot. */
public class RowBuilder {
    private val names = HashSet<String>()
    private val columns = ArrayList<Column>()
    private val values = ArrayList<RowValue>()

    public fun put(name: String, value: RowValue) {
        if (!names.add(name))
            throw AmbiguousColumnException(name)
        columns.add(Column(name))
        values.add(value)
    }

    public fun build(): Row = Row.fromValues(RowSchema.fromColumns(columns), values)
}

public object Rows {
    public fun <T> encodeToRow(value: T, writer: RowWriter<T>): Row {
        val row = RowBuilder()
        writer.writeRow(value, row)
        return row.build()
    }

    public fun <T> decodeFromRow(
        row: Row,
        reader: RowReader<T>,
        options: RowDecodingOptions = RowDecodingOptions()
    ): T = RowInput(row, "", options).read(reader)

    public fun <T> sequence(values: Array<T>, convert: (T) -> RowValue): RowValue =
        RowValue.Sequence(Array<RowValue>(values.size) { index -> convert(values[index]) })

    public fun <T> nullable(value: T?, convert: (T) -> RowValue): RowValue =
        when (value) {
            case Some(val item) -> convert(item)
            case None -> RowValue.Null
        }
}
