package scoop.db.row

import scoop.db.ResultStream
import scoop.db.mapRecords

/** Maps stable rows through the selected row reader and takes ownership of the source stream. */
public fun <T> ResultStream<Row>.decodeRecords(
    reader: RowReader<T>,
    options: RowDecodingOptions = RowDecodingOptions()
): ResultStream<T> = mapRecords { row -> Rows.decodeFromRow(row, reader, options) }
